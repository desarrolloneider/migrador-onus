# Copiar como .env en la raíz del repositorio (no se sube a git).
# En Linux de producción: /etc/migrador/migrador.env, permisos 600, dueño el usuario del servicio.
# Ninguna credencial va en el código, en pantalla, en la auditoría ni en los registros (RNF-06).

# Base de datos: dos usuarios (arquitectura 10.2). El dueño aplica migraciones; la aplicación solo lee y escribe.
DATABASE_URL=jdbc:postgresql://localhost:47432/migrador
DATABASE_OWNER_USER=migrador_owner
DATABASE_OWNER_PASSWORD=
DATABASE_APP_USER=migrador_app
DATABASE_APP_PASSWORD=

# Anclas de la auditoría fuera de la base (arquitectura 10.2). Mismo directorio para la web y el ejecutor.
# En Linux: /var/lib/migrador/anclas, con chattr +a sobre el archivo y copia en el respaldo diario.
AUDITORIA_ANCLAS_DIR=anclas

# Solo para compose.yaml (PostgreSQL local de pruebas).
POSTGRES_SUPERUSER_PASSWORD=

# SmartOLT y Wispro (PC-09, Anexo A punto 6). Solo lectura.
SMARTOLT_BASE_URL=https://guajiranet.smartolt.com
SMARTOLT_API_TOKEN=
WISPRO_BASE_URL=https://www.cloud.wispro.co/api/v1
WISPRO_API_TOKEN=

# Por cada OLT registrada, con su código en mayúsculas (PC-35):
# OLT_RIOHACHA01_USER=
# OLT_RIOHACHA01_PASSWORD=

# Consola de las OLT por SSH (PC-35). Una pareja por OLT: CONSOLA_<CODIGO>_USUARIO y _CLAVE, con el código en mayúsculas
# y los guiones cambiados por _. Solo en este archivo, nunca en el repositorio ni en el chat.
CONSOLA_OLT_CONEJO_USUARIO=
CONSOLA_OLT_CONEJO_CLAVE=

# Usuario inicial de la página. Si no existe se crea; la primera vez que entra, la página le exige cambiar la
# contraseña (y puede cambiar el usuario). Después de eso estos valores ya no se usan para nada.
MIGRADOR_ADMIN_USUARIO=admin
MIGRADOR_ADMIN_CLAVE_INICIAL=
# Huella de la llave SSH de la OLT (la muestra consola-prueba). Si la OLT presenta otra, no se conecta.
CONSOLA_OLT_CONEJO_HUELLA=

# Imágenes base del frontend: vacío = Docker Hub; si falla, usa el espejo de Google.
REGISTRO=mirror.gcr.io/library/

# Versión de las imágenes guajiranet/migrador-onu-{api,ejecutor,web}.
MIGRADOR_VERSION=1.0.0

# Puertos del servidor (poco usados). La página queda en http://<servidor>:47843
MIGRADOR_PUERTO_FRONTEND=47843
MIGRADOR_PUERTO_WEB=47880
MIGRADOR_PUERTO_BD=47432
# 127.0.0.1 = solo desde el mismo servidor. Para que la red interna abra la página: 0.0.0.0 o la IP interna del servidor.
MIGRADOR_IP_PUBLICACION=127.0.0.1

# Usuario y clave de consola SSH compartidos por todas las OLT (si una OLT tiene CONSOLA_<CODIGO>_USUARIO/_CLAVE, usa esos).
CONSOLA_GENERAL_USUARIO=
CONSOLA_GENERAL_CLAVE=
