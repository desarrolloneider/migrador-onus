# Mismo origen para la SPA, la API y el WebSocket: la cookie de sesión y el token CSRF funcionan sin CORS
# (arquitectura 11.1). En producción, el TLS lo pone el nginx de entrada delante de este contenedor.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # Las redirecciones van relativas: una absoluta perdía el puerto :4200 y el navegador la guardaba para siempre.
    absolute_redirect off;

    # Docker cambia la IP del backend cada vez que se recrea. Con el DNS de Docker y una variable, nginx la vuelve a
    # buscar en lugar de quedarse con la vieja (si no, el inicio de sesión falla con 502 tras reiniciar el backend).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    # Armar una vista previa descarga SmartOLT y Wispro completos: puede tardar varios minutos.
    location ^~ /api/v1/batches {
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /ws {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
    }

    location ~* \.(?:js|css|woff2?|ttf|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
