<mxfile host="Electron">
  <diagram id="rc3" name="Recorrido v3.0 (fase 1)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="4600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#1F3A5F;whiteSpace=wrap;" value="&lt;b&gt;Migrador de ONUs a GenieACS · recorrido del software, paso a paso, para revisión con el ingeniero (versión 3.0 · fase 1)&lt;/b&gt;"><mxGeometry x="40" y="30" width="2100" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" parent="1" vertex="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#263238;whiteSpace=wrap;" value="Arriba: el flujo con cada pregunta de sí o no y a dónde lleva cada respuesta. Abajo: una ficha por casilla con qué hace, dónde, qué lee, qué cambia y qué hay que confirmar. Basado en la spec v3.0 y la arquitectura v3.0. Fase 1: el perfil TR-069 se cambia por comando en la consola de la OLT; GenieACS queda para la fase 2. Las fichas en verde son lo nuevo de las notas del 2 de octubre y las respuestas del 3 de octubre."><mxGeometry x="40" y="80" width="2100" height="60" as="geometry"/></mxCell>
        <mxCell id="c3" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=2;" value="Lo hace la persona"><mxGeometry x="40" y="150" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="c4" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#546E7A;strokeWidth=1.5;" value="Lo hace el software: solo lee o calcula"><mxGeometry x="302" y="150" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="c5" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;" value="Lo hace el software y CAMBIA algo en la OLT"><mxGeometry x="564" y="150" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="c6" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;spacing=18;" value="Pregunta de sí o no"><mxGeometry x="826" y="150" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c7" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;" value="La ONU falla y se detiene"><mxGeometry x="1088" y="150" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="c8" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;" value="La ONU queda fuera, no se toca"><mxGeometry x="1350" y="150" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="c9" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;" value="Resultado bueno"><mxGeometry x="1612" y="150" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="c10" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=2;" value="Se detiene sin tocar nada"><mxGeometry x="1874" y="150" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="c11" parent="1" vertex="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#263238;whiteSpace=wrap;" value="Cada casilla deja un registro en la auditoría en el momento en que pasa (quién, qué, sobre cuál ONU, en qué OLT, qué comando, qué respondió) y la pantalla en vivo se actualiza sola. Por eso no se repite en cada casilla."><mxGeometry x="40" y="220" width="2100" height="36" as="geometry"/></mxCell>
        <mxCell id="c12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=14;align=left;spacingLeft=10;" value="&lt;b&gt;Parte A · Entrar y preparar el lote&lt;/b&gt; — proceso web, nada cambia en la red"><mxGeometry x="40" y="290" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="c13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=14;align=left;spacingLeft=10;" value="&lt;b&gt;Clasificación de cada ONU (dentro de A7)&lt;/b&gt; — se repite por cada ONU"><mxGeometry x="600" y="290" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="c14" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=14;align=left;spacingLeft=10;" value="&lt;b&gt;Parte B · Ejecutar cada ONU&lt;/b&gt; — proceso ejecutor, aquí sí cambia la OLT"><mxGeometry x="1160" y="290" width="500" height="34" as="geometry"/></mxCell>
