        <mxCell id="c156" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=2;" value="&lt;b&gt;Lote detenido&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;pendientes: &amp;quot;no iniciada&amp;quot;&lt;/font&gt;"><mxGeometry x="2030" y="485" width="240" height="60" as="geometry"/></mxCell>
