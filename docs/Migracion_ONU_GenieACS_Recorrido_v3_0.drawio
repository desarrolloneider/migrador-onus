        <mxCell id="c160" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=2;" value="&lt;b&gt;Detenido automáticamente&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;RN-29&lt;/font&gt;"><mxGeometry x="2030" y="650" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c161" parent="1" edge="1" source="c158" target="c160" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C62828;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="sí"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c162" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;spacing=18;" value="&lt;b&gt;C4 · ¿Quedan ONUs pendientes?&lt;/b&gt;"><mxGeometry x="1720" y="785" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="c163" parent="1" edge="1" source="c158" target="c162" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#455A64;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;" value="no"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c164" parent="1" edge="1" source="c162" target="c100" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#455A64;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;" value="sí → B1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c165" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;" value="&lt;b&gt;Lote terminado&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;o &amp;quot;terminado con fallas&amp;quot; si alguna falló&lt;/font&gt;"><mxGeometry x="1720" y="950" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="c166" parent="1" edge="1" source="c162" target="c165" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#455A64;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;" value="no"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c167" parent="1" edge="1" source="c47" target="c100" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#455A64;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="lote confirmado"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c168" parent="1" edge="1" source="c150" target="c153" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#455A64;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c169" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=14;align=left;spacingLeft=10;" value="&lt;b&gt;Fichas por casilla&lt;/b&gt;"><mxGeometry x="40" y="2760" width="2100" height="36" as="geometry"/></mxCell>
        <mxCell id="c170" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Parte A&lt;/b&gt;"><mxGeometry x="40" y="2816" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="c171" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4527A0;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;A1-A2 · Inicio de sesión&lt;/b&gt;&lt;br&gt;Qué hace: entra con usuario y contraseña propios de la herramienta.&lt;br&gt;Dónde: proceso web.&lt;br&gt;Lee: usuarios de la herramienta.&lt;br&gt;Cambia: nada en la red.&lt;br&gt;Por confirmar: quién crea usuarios (PC-13, propuesta: por consola)."><mxGeometry x="40" y="2856" width="500" height="152" as="geometry"/></mxCell>
        <mxCell id="c172" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4527A0;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;A3 · Cómo trabajar&lt;/b&gt;&lt;br&gt;Qué hace: escoge lote (marca Huawei y, si quiere, OLT, tarjeta y puerto PON) o una sola ONU por SN.&lt;br&gt;De dónde sale: notas del 2 de octubre, las tarjetas se manejan como lista por OLT.&lt;br&gt;Por confirmar: la lista real de tarjetas de cada OLT (PC-39)."><mxGeometry x="40" y="3022" width="500" height="136" as="geometry"/></mxCell>
        <mxCell id="c173" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4527A0;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;A4-A5 · Lee SmartOLT&lt;/b&gt;&lt;br&gt;Qué hace: descarga las ONUs con SN, marca, modelo, OLT, tarjeta, puerto, ID, estado en línea, IP y perfil TR-069 si lo trae. Si la descarga queda incompleta, no se arma nada.&lt;br&gt;Cambia: nada.&lt;br&gt;Por confirmar: los puntos exactos de la API (PC-09) y que SmartOLT traiga la IP (PC-32)."><mxGeometry x="40" y="3172" width="500" height="136" as="geometry"/></mxCell>
        <mxCell id="c174" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4527A0;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;A6 · Lee Wispro&lt;/b&gt;&lt;br&gt;Qué hace: descarga los contratos con su IP una sola vez y cruza en memoria.&lt;br&gt;Cambia: nada; Wispro solo se lee (PC-08 cerrado).&lt;br&gt;Por confirmar: ruta para buscar por IP y cómo pagina (Anexo A, punto 6)."><mxGeometry x="40" y="3322" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="c175" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4527A0;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;A8 · Máximo por lote&lt;/b&gt;&lt;br&gt;Qué hace: compara la cantidad con el máximo.&lt;br&gt;Respondido (3 oct): 50 ONUs por lote para empezar; si sale bien, 200."><mxGeometry x="40" y="3456" width="500" height="88" as="geometry"/></mxCell>
        <mxCell id="c176" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4527A0;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;A9-A12 · Vista previa y confirmación&lt;/b&gt;&lt;br&gt;Qué hace: muestra tres grupos con su motivo; vence a los 30 minutos (respondido 3 oct) y queda &amp;quot;descartada&amp;quot; sin borrar nada. Si no se ha decidido si se guarda la configuración de la OLT (PC-36), solo deja simular.&lt;br&gt;Cambia: nada hasta confirmar."><mxGeometry x="40" y="3558" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="c177" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Clasificación&lt;/b&gt;"><mxGeometry x="570" y="2816" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="c178" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;K1 · Formato del SN&lt;/b&gt;&lt;br&gt;Lleva el SN al formato común: aparece en texto HWTC… y en hexadecimal (respondido 3 oct)."><mxGeometry x="570" y="2856" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="c179" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;K2 · SN repetido&lt;/b&gt;&lt;br&gt;Nuevo (notas del 2 oct): si el SN aparece más de una vez en SmartOLT, se usa el registro que está en línea y los demás se guardan como dato, sin tocarlos. Si ninguno o más de uno está en línea, la herramienta no escoge: queda fuera."><mxGeometry x="570" y="2942" width="500" height="88" as="geometry"/></mxCell>
        <mxCell id="c180" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;K3 · Marca&lt;/b&gt;&lt;br&gt;Solo Huawei. Todos los Huawei usan los mismos parámetros (2 y 3 oct): ya no hay lista de modelos."><mxGeometry x="570" y="3044" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="c181" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;K4 · En línea&lt;/b&gt;&lt;br&gt;La ONU debe estar en línea.&lt;br&gt;Por confirmar (PC-40): como el cambio es en la OLT, ¿se podría hacer aunque la ONU esté apagada?"><mxGeometry x="570" y="3130" width="500" height="88" as="geometry"/></mxCell>
        <mxCell id="c182" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;K5 a K7 · Cruce por IP&lt;/b&gt;&lt;br&gt;Nuevo: el cruce con Wispro es por IP, ya no por SN, porque el SN de Wispro se llena a mano y hay equipos cambiados.&lt;br&gt;Por confirmar (PC-32): la IP sale de SmartOLT &amp;quot;si no estoy mal&amp;quot; (líder técnico, 5 oct). Hay que verificarlo."><mxGeometry x="570" y="3232" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c183" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;K8 · Tarjeta y acceso&lt;/b&gt;&lt;br&gt;La tarjeta debe estar en la lista de la OLT, y la OLT debe tener configurado su acceso por consola.&lt;br&gt;Por confirmar: SSH o Telnet, dirección y usuario de la herramienta (PC-35)."><mxGeometry x="570" y="3350" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c184" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;K9 · Ya tiene el perfil&lt;/b&gt;&lt;br&gt;Si SmartOLT ya muestra guajiranet1, va al grupo &amp;quot;ya tienen el perfil&amp;quot;. De todos modos P03 lo revisa en la OLT.&lt;br&gt;Las ONUs que ya están en GenieACS también entran (PC-03 cerrado): en la fase 1 no se lee GenieACS."><mxGeometry x="570" y="3468" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c185" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;K10-K12&lt;/b&gt;&lt;br&gt;Una ONU en un solo lote activo; una fallida sin revisar no vuelve a un lote; el resto entra."><mxGeometry x="570" y="3586" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="c186" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Parte B&lt;/b&gt;"><mxGeometry x="1100" y="2816" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="c187" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;P01 · Revalidar&lt;/b&gt;&lt;br&gt;Lee de nuevo SmartOLT y Wispro. Si algo cambió desde la vista previa (IP, contrato, posición, estado), la ONU sale sin tocarla."><mxGeometry x="1100" y="2856" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="c188" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;P02 · Abrir sesión en la OLT&lt;/b&gt;&lt;br&gt;Conecta a la consola de la OLT de esa ONU con el usuario de la herramienta. Una sola sesión por OLT a la vez. Si la OLT rechaza las credenciales, se detiene el lote entero.&lt;br&gt;Por confirmar: PC-35."><mxGeometry x="1100" y="2942" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c189" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;P03 · Fotografía previa&lt;/b&gt;&lt;br&gt;Lee el perfil TR-069 actual de la ONU en la OLT y lo guarda. Si ya tiene guajiranet1, no se manda ningún cambio.&lt;br&gt;Por confirmar: el comando de lectura (PC-34). Sin él no se puede verificar nada."><mxGeometry x="1100" y="3060" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c190" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;P04 · Entrar a la tarjeta&lt;/b&gt;&lt;br&gt;Manda config y luego interface gpon 0/&amp;lt;tarjeta&amp;gt;. La tarjeta sale de SmartOLT y debe estar en la lista permitida.&lt;br&gt;De dónde sale: notas del 2 oct."><mxGeometry x="1100" y="3178" width="500" height="88" as="geometry"/></mxCell>
        <mxCell id="c191" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;P05 · Quitar el perfil viejo&lt;/b&gt;&lt;br&gt;Manda undo ont tr069-server-config &amp;lt;puerto&amp;gt; &amp;lt;id&amp;gt; (ejemplo de las notas: puerto 0, ID 33). Luego lee para verificar que se quitó.&lt;br&gt;Por confirmar: si la OLT pide confirmación (PC-33). Una pregunta no conocida hace fallar la ONU."><mxGeometry x="1100" y="3280" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c192" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;P06 · Asignar guajiranet1&lt;/b&gt;&lt;br&gt;Asigna el perfil guajiranet1 a esa ONU y lee para verificar.&lt;br&gt;Por confirmar: sintaxis exacta, por nombre o por número (PC-33), y si el cliente pierde internet entre P05 y P06 (PC-38)."><mxGeometry x="1100" y="3398" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c193" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;P07 · Guardar&lt;/b&gt;&lt;br&gt;Guarda la configuración de la OLT para que el cambio sobreviva a un reinicio.&lt;br&gt;Por confirmar: si se guarda, con qué comando y cuándo: por ONU o al final del lote (PC-36)."><mxGeometry x="1100" y="3516" width="500" height="104" as="geometry"/></mxCell>
        <mxCell id="c194" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;P08 · Cerrar&lt;/b&gt;&lt;br&gt;Sale de la tarjeta y de la configuración, cierra la sesión, marca la ONU completada y el historial dice &amp;quot;corregida&amp;quot;."><mxGeometry x="1100" y="3634" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="c195" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Parte C&lt;/b&gt;"><mxGeometry x="1630" y="2816" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="c196" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B5E20;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;C1-C5 · Cerrar el lote&lt;/b&gt;&lt;br&gt;Después de cada ONU: si pidieron detener, se detiene; si 3 ONUs seguidas no tuvieron respuesta de la misma OLT o sistema, se detiene solo; si quedan pendientes, sigue; si no, termina."><mxGeometry x="1630" y="2856" width="500" height="88" as="geometry"/></mxCell>
        <mxCell id="c197" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B5E20;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fillColor=#F1F8E9;" value="&lt;b&gt;Historial de ONUs&lt;/b&gt;&lt;br&gt;Nuevo (notas del 2 oct): página con cuáles ONUs quedaron corregidas y cuáles no, de todos los lotes, con totales, filtros y exportación."><mxGeometry x="1630" y="2958" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="c198" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B5E20;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;En pausa&lt;/b&gt;&lt;br&gt;Corrida periódica &amp;quot;cada cierto tiempo&amp;quot; (PC-37). No se construye mientras tanto."><mxGeometry x="1630" y="3044" width="500" height="56" as="geometry"/></mxCell>
        <mxCell id="c199" parent="1" vertex="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B5E20;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Fase 2 (no se construye ahora)&lt;/b&gt;&lt;br&gt;VLAN de gestión 46, esperar a GenieACS, cambiar la conexión a TR069_INTERNET, verificar y quitar la VLAN. Usa el mismo motor de pasos."><mxGeometry x="1630" y="3114" width="500" height="72" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
