        <mxCell id="c158" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;spacing=18;" value="&lt;b&gt;C3 · ¿3 ONUs seguidas sin respuesta de la misma OLT o sistema?&lt;/b&gt;"><mxGeometry x="1720" y="620" width="280" height="120" as="geometry"/></mxCell>
