        <mxCell id="c152" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;" value="&lt;b&gt;Toda falla&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;lee el estado al fallar, cierra la sesión, ONU fallida, historial &amp;quot;fallida&amp;quot;; el lote sigue con la siguiente&lt;/font&gt;"><mxGeometry x="1460" y="2660" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c153" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#546E7A;strokeWidth=1.5;" value="&lt;b&gt;C1 · Después de cada ONU&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;actualiza contadores e historial&lt;/font&gt;"><mxGeometry x="1720" y="350" width="280" height="60" as="geometry"/></mxCell>
